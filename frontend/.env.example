# Tavern of Disaster — Frontend environment
# Copy to frontend/.env.local (optional; the defaults work for local dev).

# Origem do backend para REST e Socket.IO.
#
# Deixe VAZIO para usar a mesma origem da página:
# - dev: o Vite faz proxy de /api, /socket.io e /uploads para localhost:3001;
# - produção: o proxy reverso do domínio faz o mesmo.
#
# Preencha apenas se o backend estiver em outra origem, por exemplo:
# VITE_API_URL=https://api.seudominio.com
VITE_API_URL=

# Enable Vue DevTools plugin during local development only.
VITE_ENABLE_DEVTOOLS=false
