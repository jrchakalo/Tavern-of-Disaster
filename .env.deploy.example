# Credenciais de deploy do beta (NÃO versionar este arquivo).
# Copie para `.env.deploy` e preencha. Nenhum valor deve ser colado no chat.
# O agente lê este arquivo localmente; ele está no .gitignore.

# --- GitHub (push do branch main) ---
# Fine-grained PAT: Repository access -> Tavern-of-Disaster
# Permissions: Contents = Read and write; Metadata = Read.
GITHUB_TOKEN=

# --- MongoDB Atlas M0 ---
# Connection string SRV com usuário/senha do banco (URL-encode se necessário).
MONGO_URI=

# --- Supabase (storage) ---
# Project URL (https://<ref>.supabase.co), service_role key e bucket público.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tavern-assets
# Opcional: para o agente criar o bucket via API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Render (backend) ---
# Account Settings -> API Keys.
RENDER_API_KEY=
# Preenchido depois de criar o Blueprint (srv-...).
RENDER_SERVICE_ID=
# URL pública do serviço (https://<servico>.onrender.com).
RENDER_URL=
# URL completa de /health para keep-alive/monitor.
RENDER_HEALTH_URL=

# --- Vercel (frontend) ---
# Account Settings -> Tokens.
VERCEL_TOKEN=

# --- Metered Open Relay (TURN) ---
# Dashboard -> app -> credentials. Use as URLs TCP/UDP 443 quando possível.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Gerados pelo agente/scripts (não invente) ---
JWT_SECRET=
METRICS_TOKEN=
