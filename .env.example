# ============================================================
# Tavern of Disaster — Backend environment
# Copy to backend/.env and fill the values.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/tavern_of_disaster
JWT_SECRET=change_this_secret_in_production

# --- CORS ---
# Comma-separated list in production, e.g. https://tavernofdisaster.vercel.app
# Leave empty or * only for local development.
CORS_ORIGIN=

# --- Public app URL / display tokens ---
# Origin used to build the TV display URL (e.g. https://app.example.com).
# Falls back to CORS_ORIGIN when empty.
PUBLIC_APP_URL=

# JWT lifetime; login and refresh use the same value.
JWT_EXPIRES_IN=6h

# --- WebRTC media (Phase 5) ---
# STUN is public; TURN is required for some NAT/firewall combinations.
# Metered Open Relay free tier: 20 GB/month. Leave empty for LAN/STUN-only.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Logging / observability ---
LOG_LEVEL=info
AUTH_FAILURE_ALERT_THRESHOLD=10
TOKEN_MOVE_ERROR_ALERT_THRESHOLD=20

# --- In-memory measurement cleanup ---
MEASUREMENT_IDLE_TTL_MS=1800000
MEASUREMENT_CLEANUP_INTERVAL_MS=300000

# --- Storage (uploads) ---
# local  = grava em disco (backend/uploads) e serve em /uploads — padrão e grátis.
# supabase = object storage (requer as três variáveis abaixo).
# Se STORAGE_DRIVER não for definido, usa supabase quando as três variáveis
# estiverem preenchidas; caso contrário, usa local.
STORAGE_DRIVER=local
# Diretório absoluto ou relativo para o driver local (padrão: backend/uploads).
LOCAL_UPLOAD_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Base pública dos assets. Deixe vazio para gerar URLs relativas
# (/uploads/...), que funcionam atrás do proxy do frontend em qualquer
# dispositivo. Defina apenas se os assets forem servidos por outra origem.
ASSET_BASE_URL=

# Image processing limits (bytes unless noted)
ASSET_MAX_WIDTH=8192
ASSET_MAX_HEIGHT=8192
ASSET_MAX_BYTES=41943040
MAP_MAX_WIDTH=8192
MAP_MAX_HEIGHT=8192
MAP_MAX_BYTES=41943040
TOKEN_MAX_WIDTH=1024
TOKEN_MAX_HEIGHT=1024
TOKEN_MAX_BYTES=8388608
AVATAR_MAX_WIDTH=512
AVATAR_MAX_HEIGHT=512
AVATAR_MAX_BYTES=4194304

# Quota total de armazenamento por mesa (bytes). Padrão: 200 MB.
TABLE_STORAGE_QUOTA_BYTES=209715200
# Assets sem referência em cena/token/usuário/personagem/template só são
# apagados pela varredura depois deste TTL (padrão: 24h).
ASSET_ORPHAN_TTL_MS=86400000
# Intervalo da varredura de órfãos (padrão: 6h). 0 desabilita.
ASSET_ORPHAN_SWEEP_INTERVAL_MS=21600000
